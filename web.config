<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + iisnode yapılandırması.

  Ön koşullar (sunucuda, tek seferlik):
  1. IIS'e "URL Rewrite" modülü kurulu olmalı.
  2. IIS'e "iisnode" modülü kurulu olmalı (https://github.com/Azure/iisnode).
  3. Bu klasörü gösteren bir IIS sitesi/uygulaması oluşturulmalı, Application Pool
     "No Managed Code" olarak ayarlanmalı.
  4. Site oluşturulmadan önce en az bir kez elle çalıştırılmalı: `npm install`,
     `cd frontend && npm install && npm run build` (frontend/dist üretilmeli).

  Node/Express tüm istekleri (statik frontend + API) tek başına karşılıyor;
  bu yüzden burada karmaşık bir rewrite mantığına gerek yok — her şey src/app.js'e
  yönlendiriliyor, ayrım Express tarafında yapılıyor (bkz. src/app.js).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="src/app.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="ITManager-AllToNode" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="src/app.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Hassas klasörlere doğrudan HTTP erişimini engelle (defense-in-depth;
         yukarıdaki rewrite kuralı zaten tüm istekleri iisnode'a yönlendiriyor,
         bu sadece ek güvenlik katmanı) -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="data" />
          <add segment="backups" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      loggingEnabled="true"
      logDirectory="iisnode-logs"
      watchedFiles="web.config"
      devErrorsEnabled="true"
    />
    <!--
      watchedFiles bilinçli olarak sadece web.config: src/**/*.js dosyalarını da
      izlemeye alırsak, güncelleme sırasında git reset/npm install ile değişen
      onlarca dosya iisnode'un process'i kontrolsüzce, defalarca yeniden başlatmasına
      (recycle) yol açar. Kontrollü tek restart, güncelleme tamamlandığında
      src/modules/update/controller.js -> restartServer() içinde web.config'in
      mtime'ı güncellenerek (touch) tetikleniyor.
    -->
  </system.webServer>
</configuration>
